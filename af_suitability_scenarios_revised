# -----------------------------------------------------------------------------
# 18.5 FIXED — Mixed-condition biophysical builder
#
# The function argument is named `scenario_name` to avoid collision with the
# `scenario` column in mixed_c_factors.
# -----------------------------------------------------------------------------

build_mixed_condition_biophys <- function(
    scenario_name = NULL
) {
  table_label <- if (is.null(scenario_name)) {
    "noAF_reference"
  } else {
    as.character(scenario_name)
  }
  
  if (
    !is.null(scenario_name) &&
    !scenario_name %in% mixed_scenarios
  ) {
    stop(
      "Unknown mixed-condition scenario: ",
      scenario_name
    )
  }
  
  canonical_rows <- biophys_canonical_mixed |>
    filter(
      !lucode %in%
        mixed_special_lucodes
    ) |>
    transmute(
      component = "canonical",
      lucode = as.integer(lucode),
      usle_c = as.numeric(usle_c),
      usle_p = 1.00
    )
  
  degraded_baseline_rows <- mixed_c_factors |>
    distinct(
      land_use,
      degraded_noaf_code,
      c_base_degraded
    ) |>
    transmute(
      component = "degraded_baseline",
      lucode = as.integer(
        degraded_noaf_code
      ),
      usle_c = as.numeric(
        c_base_degraded
      ),
      usle_p = 1.00
    )
  
  nondegraded_af_rows <- tibble(
    component = character(),
    lucode = integer(),
    usle_c = double(),
    usle_p = double()
  )
  
  if (is.null(scenario_name)) {
    degraded_af_rows <- tibble(
      component = character(),
      lucode = integer(),
      usle_c = double(),
      usle_p = double()
    )
  } else {
    degraded_af_rows <- mixed_c_factors |>
      filter(.data$scenario == scenario_name) |>
      transmute(
        component = "degraded_AF",
        lucode = as.integer(degraded_af_code),
        usle_c = as.numeric(c_af_degraded),
        usle_p = 1.00
      )
    
    if (nrow(degraded_af_rows) != 3L) {
      stop(
        "Expected exactly three degraded AF rows for scenario `",
        scenario_name,
        "`; found ",
        nrow(degraded_af_rows),
        "."
      )
    }
  }
  
  component_rows <- bind_rows(
    canonical_rows,
    degraded_baseline_rows,
    nondegraded_af_rows,
    degraded_af_rows
  ) |>
    mutate(
      lucode = as.integer(lucode),
      usle_c = as.numeric(usle_c),
      usle_p = 1.00
    ) |>
    arrange(
      lucode,
      component
    )
  
  duplicate_detail <- component_rows |>
    add_count(
      lucode,
      name = "n_rows_per_lucode"
    ) |>
    filter(
      n_rows_per_lucode > 1L
    )
  
  write_csv(
    component_rows,
    file.path(
      mixed_validation_dir,
      paste0(
        "VALIDATION_mixed_condition_component_audit_",
        table_label,
        ".csv"
      )
    )
  )
  
  write_csv(
    duplicate_detail,
    file.path(
      mixed_validation_dir,
      paste0(
        "VALIDATION_mixed_condition_duplicate_lucodes_",
        table_label,
        ".csv"
      )
    )
  )
  
  if (nrow(duplicate_detail) > 0L) {
    print(
      duplicate_detail,
      n = Inf
    )
    
    stop(
      paste0(
        "Duplicate lucodes remain in the ",
        table_label,
        " mixed-condition biophysical table. ",
        "See VALIDATION_mixed_condition_duplicate_lucodes_",
        table_label,
        ".csv."
      )
    )
  }
  
  result <- component_rows |>
    select(
      lucode,
      usle_c,
      usle_p
    ) |>
    arrange(lucode)
  
  expected_special_codes <- if (is.null(scenario_name)) {
    sort(mixed_code_map$degraded_noaf_code)
  } else {
    sort(c(
      mixed_code_map$degraded_noaf_code,
      mixed_code_map$degraded_af_code
    ))
  }
  
  observed_special_codes <- sort(
    intersect(
      result$lucode,
      mixed_special_lucodes
    )
  )
  
  if (
    !identical(
      observed_special_codes,
      expected_special_codes
    )
  ) {
    stop(
      paste0(
        "Incorrect mixed special-code set in ",
        table_label,
        ". Expected: ",
        paste(
          expected_special_codes,
          collapse = ", "
        ),
        "; observed: ",
        paste(
          observed_special_codes,
          collapse = ", "
        )
      )
    )
  }
  
  if (
    any(
      !is.finite(result$usle_c) |
      result$usle_c < 0 |
      result$usle_c > 1
    )
  ) {
    stop(
      "Invalid C-factor in mixed-condition table: ",
      table_label
    )
  }
  
  if (
    any(
      !is.finite(result$usle_p) |
      result$usle_p != 1.00
    )
  ) {
    stop(
      "All mixed-condition P-factors must equal 1.00: ",
      table_label
    )
  }
  
  result
}

