# -----------------------------------------------------------------------------
# 18.13 Write 18 mixed-condition AF scenario folders
#
# AF eligibility:
#   suitability mask AND SDG degraded status (-1) AND source LULC 20/30/40
#
# Only degraded pixels transition to 26/36/46. Non-degraded source pixels
# remain at 20/30/40 in every degraded-land scenario.
# -----------------------------------------------------------------------------

mixed_transition_list <- list()
mixed_run_transition_check_list <- list()
mixed_transition_index <- 1L
mixed_run_check_index <- 1L

for (i in seq_len(nrow(scenario_grid_mixed))) {
  climate_i <- scenario_grid_mixed$climate[i]
  scenario_i <- scenario_grid_mixed$scenario[i]
  threshold_i <- scenario_grid_mixed$threshold[i]
  run_id_i <- scenario_grid_mixed$run_id[i]
  mask_path_i <- scenario_grid_mixed$mask_path[i]
  reference_run_i <- scenario_grid_mixed$reference_run_id[i]
  
  suitability_i <- get_suitability_mask_mixed(
    climate_i,
    threshold_i
  )
  
  run_dir_i <- file.path(
    mixed_input_root,
    run_id_i
  )
  
  dir.create(
    run_dir_i,
    recursive = TRUE,
    showWarnings = FALSE
  )
  
  scenario_lulc_i <- lulc_mixed_noaf
  
  for (j in seq_len(nrow(mixed_code_map))) {
    land_use_j <- mixed_code_map$land_use[j]
    source_j <- mixed_code_map$source_code[j]
    degraded_noaf_j <- mixed_code_map$degraded_noaf_code[j]
    nondegraded_af_j <- mixed_code_map$nondegraded_af_code[j]
    degraded_af_j <- mixed_code_map$degraded_af_code[j]
    
    selected_degraded_j <- suitability_i &
      degraded_status_r &
      lulc_base_r == source_j
    
    # Explicitly empty by design: non-degraded pixels are controls here.
    selected_nondegraded_j <- suitability_i &
      nondegraded_status_r &
      lulc_base_r == source_j &
      FALSE
    
    scenario_lulc_i <- ifel(
      selected_degraded_j,
      degraded_af_j,
      scenario_lulc_i
    )
    
    # No non-degraded AF transition in the degraded-only analysis.
    
    c_row_j <- mixed_c_factors |>
      filter(
        .data$scenario == scenario_i,
        .data$land_use == land_use_j
      )
    
    if (nrow(c_row_j) != 1L) {
      stop(
        "Expected exactly one C-factor row for ",
        scenario_i,
        " / ",
        land_use_j,
        "."
      )
    }
    
    mixed_transition_list[[mixed_transition_index]] <- tibble(
      run_id = run_id_i,
      climate = climate_i,
      scenario = scenario_i,
      threshold = threshold_i,
      land_use = land_use_j,
      source_code = source_j,
      degraded_noaf_code = degraded_noaf_j,
      nondegraded_af_code = nondegraded_af_j,
      degraded_af_code = degraded_af_j,
      c_base_nondegraded =
        c_row_j$c_base_nondegraded,
      c_af_nondegraded =
        c_row_j$c_af_nondegraded,
      c_reduction_nondegraded_pct =
        100 *
        (
          1 -
            c_row_j$c_af_nondegraded /
            c_row_j$c_base_nondegraded
        ),
      c_base_degraded =
        c_row_j$c_base_degraded,
      c_af_degraded =
        c_row_j$c_af_degraded,
      c_reduction_degraded_pct =
        100 *
        (
          1 -
            c_row_j$c_af_degraded /
            c_row_j$c_base_degraded
        ),
      total_source_cells = count_true_mixed(
        lulc_base_r == source_j
      ),
      degraded_source_cells = count_true_mixed(
        degraded_status_r &
          lulc_base_r == source_j
      ),
      nondegraded_source_cells = count_true_mixed(
        nondegraded_status_r &
          lulc_base_r == source_j
      ),
      selected_degraded_AF_cells = count_true_mixed(
        selected_degraded_j
      ),
      selected_nondegraded_AF_cells = count_true_mixed(
        selected_nondegraded_j
      ),
      selected_total_AF_cells = count_true_mixed(
        selected_degraded_j |
          selected_nondegraded_j
      )
    )
    
    mixed_transition_index <-
      mixed_transition_index + 1L
  }
  
  names(scenario_lulc_i) <- "lulc"
  
  changed_from_noAF_i <- scenario_lulc_i != lulc_mixed_noaf
  
  changed_outside_suitability_i <- count_true_mixed(
    changed_from_noAF_i &
      !suitability_i
  )
  
  changed_outside_source_LULC_i <- count_true_mixed(
    changed_from_noAF_i &
      !af3_source_r
  )
  
  changed_on_nondegraded_i <- count_true_mixed(
    changed_from_noAF_i &
      nondegraded_status_r
  )
  
  invalid_degraded_transition_i <- count_true_mixed(
    changed_from_noAF_i &
      degraded_status_r &
      !(
        (
          lulc_mixed_noaf == 21L &
            scenario_lulc_i == 26L
        ) |
          (
            lulc_mixed_noaf == 31L &
              scenario_lulc_i == 36L
          ) |
          (
            lulc_mixed_noaf == 41L &
              scenario_lulc_i == 46L
          )
      )
  )
  
  invalid_nondegraded_transition_i <- count_true_mixed(
    changed_from_noAF_i &
      nondegraded_status_r &
      !(
        (
          lulc_mixed_noaf == 20L &
            scenario_lulc_i == 25L
        ) |
          (
            lulc_mixed_noaf == 30L &
              scenario_lulc_i == 35L
          ) |
          (
            lulc_mixed_noaf == 40L &
              scenario_lulc_i == 45L
          )
      )
  )
  
  expected_transition_count_i <- count_true_mixed(
    suitability_i &
      degraded_status_r &
      af3_source_r
  )
  
  observed_transition_count_i <- count_true_mixed(
    changed_from_noAF_i
  )
  
  transition_count_difference_i <-
    observed_transition_count_i -
    expected_transition_count_i
  
  mixed_run_transition_check_list[[mixed_run_check_index]] <- tibble(
    run_id = run_id_i,
    climate = climate_i,
    scenario = scenario_i,
    threshold = threshold_i,
    expected_total_AF_transition_cells =
      expected_transition_count_i,
    observed_total_AF_transition_cells =
      observed_transition_count_i,
    transition_count_difference =
      transition_count_difference_i,
    changed_outside_suitability =
      changed_outside_suitability_i,
    changed_outside_source_LULC =
      changed_outside_source_LULC_i,
    changed_on_nondegraded_cells =
      changed_on_nondegraded_i,
    invalid_degraded_transition_cells =
      invalid_degraded_transition_i,
    invalid_nondegraded_transition_cells =
      invalid_nondegraded_transition_i,
    status = if_else(
      transition_count_difference_i == 0L &
        changed_outside_suitability_i == 0L &
        changed_outside_source_LULC_i == 0L &
        changed_on_nondegraded_i == 0L &
        invalid_degraded_transition_i == 0L &
        invalid_nondegraded_transition_i == 0L,
      "PASS",
      "FAIL"
    )
  )
  
  mixed_run_check_index <-
    mixed_run_check_index + 1L
  
  if (
    transition_count_difference_i != 0L ||
    changed_outside_suitability_i != 0L ||
    changed_outside_source_LULC_i != 0L ||
    changed_on_nondegraded_i != 0L ||
    invalid_degraded_transition_i != 0L ||
    invalid_nondegraded_transition_i != 0L
  ) {
    stop(
      paste0(
        "Mixed-condition AF transition failure in ",
        run_id_i,
        ". count_difference=",
        transition_count_difference_i,
        "; outside_suitability=",
        changed_outside_suitability_i,
        "; outside_source=",
        changed_outside_source_LULC_i,
        "; changed_nondegraded=",
        changed_on_nondegraded_i,
        "; invalid_degraded=",
        invalid_degraded_transition_i,
        "; invalid_nondegraded=",
        invalid_nondegraded_transition_i
      )
    )
  }
  
  scenario_biophys_i <- biophys_mixed_by_scenario[[scenario_i]]
  
  lulc_out_i <- file.path(
    run_dir_i,
    "lulc.tif"
  )
  
  biophys_out_i <- file.path(
    run_dir_i,
    "biophysical_table.csv"
  )
  
  writeRaster(
    scenario_lulc_i,
    lulc_out_i,
    overwrite = TRUE,
    datatype = "INT2S",
    gdal = c(
      "COMPRESS=LZW"
    )
  )
  
  write_csv(
    scenario_biophys_i,
    biophys_out_i
  )
  
  mixed_manifest_list[[mixed_manifest_index]] <- tibble(
    run_id = run_id_i,
    run_type =
      "degraded_AF_scenario",
    climate = climate_i,
    scenario = scenario_i,
    threshold = threshold_i,
    reference_run_id = reference_run_i,
    run_dir = normalizePath(
      run_dir_i,
      winslash = "/",
      mustWork = TRUE
    ),
    lulc_path = normalizePath(
      lulc_out_i,
      winslash = "/",
      mustWork = TRUE
    ),
    biophysical_table_path = normalizePath(
      biophys_out_i,
      winslash = "/",
      mustWork = TRUE
    ),
    suitability_mask_path = normalizePath(
      mask_path_i,
      winslash = "/",
      mustWork = TRUE
    ),
    degraded_band_path = normalizePath(
      degraded_band_path,
      winslash = "/",
      mustWork = TRUE
    ),
    AF_eligibility_rule =
      "Suitable degraded AF3 source pixels only; non-degraded pixels unchanged",
    forcing_requirement = if_else(
      climate_i == "Baseline",
      "Use Baseline erosivity and other Baseline forcing",
      "Use SSP370 erosivity and other SSP370 forcing"
    )
  )
  
  mixed_manifest_index <-
    mixed_manifest_index + 1L
}

