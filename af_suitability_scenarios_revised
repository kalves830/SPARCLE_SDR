# -----------------------------------------------------------------------------
# 18.6 Helper functions for raster alignment, masks, and counts
# -----------------------------------------------------------------------------

count_true_mixed <- function(x) {
  result <- global(
    ifel(
      !is.na(x) & x,
      1,
      0
    ),
    fun = "sum",
    na.rm = TRUE
  )
  
  as.numeric(result[1, 1])
}

align_to_lulc_mixed <- function(x) {
  if (
    compareGeom(
      x,
      lulc_base_r,
      stopOnError = FALSE
    )
  ) {
    return(x)
  }
  
  project(
    x,
    lulc_base_r,
    method = "near"
  )
}

align_binary_mask_mixed <- function(mask_path) {
  if (!file.exists(mask_path)) {
    stop(
      "Suitability mask not found: ",
      mask_path
    )
  }
  
  mask_r <- rast(mask_path)
  
  if (nlyr(mask_r) != 1L) {
    stop(
      "Suitability mask must contain one raster layer: ",
      mask_path
    )
  }
  
  mask_r <- align_to_lulc_mixed(mask_r)
  
  !is.na(mask_r) & mask_r > 0
}

normalize_climate_mixed <- function(x) {
  x <- str_to_lower(as.character(x))
  
  case_when(
    str_detect(x, "ssp.?370") ~ "SSP370",
    str_detect(x, "baseline|^base$") ~ "Baseline",
    TRUE ~ NA_character_
  )
}

normalize_threshold_mixed <- function(x) {
  value <- parse_number(as.character(x))
  
  value <- if_else(
    is.finite(value) &
      value > 0 &
      value <= 1,
    value * 100,
    value
  )
  
  as.integer(round(value))
}

normalize_manifest_names_mixed <- function(x) {
  names(x) <- names(x) |>
    str_to_lower() |>
    str_replace_all("[^a-z0-9]+", "_") |>
    str_replace_all("^_|_$", "")
  
  x
}

first_matching_column_mixed <- function(
    nms,
    candidates
) {
  matches <- candidates[
    candidates %in% nms
  ]
  
  if (length(matches) == 0L) {
    return(NA_character_)
  }
  
  matches[1]
}

