clean_names_20b <- function(x) {
  names(x) <- names(x) |>
    str_to_lower() |>
    str_replace_all("[^a-z0-9]+", "_") |>
    str_replace_all("^_|_$", "")
  
  x
}

pick_column_20b <- function(
    nms,
    candidates,
    required = TRUE,
    label = "column"
) {
  exact_hit <- candidates[
    candidates %in% nms
  ]
  
  if (length(exact_hit) > 0L) {
    return(exact_hit[1])
  }
  
  if (required) {
    stop(
      "Could not identify ",
      label,
      ". Available columns: ",
      paste(nms, collapse = ", ")
    )
  }
  
  NA_character_
}

normalise_climate_20b <- function(x) {
  x <- str_to_lower(as.character(x))
  
  case_when(
    str_detect(x, "ssp.?370") ~ "SSP370",
    str_detect(x, "baseline|^base$") ~ "Baseline",
    TRUE ~ NA_character_
  )
}

normalise_scenario_20b <- function(x) {
  x <- str_to_lower(as.character(x))
  
  case_when(
    str_detect(x, "conserv") ~ "conservative",
    str_detect(x, "central|medium|mid") ~ "central",
    str_detect(x, "optim") ~ "optimistic",
    TRUE ~ NA_character_
  )
}

normalise_threshold_20b <- function(x) {
  value <- parse_number(as.character(x))
  
  value <- if_else(
    is.finite(value) &
      value > 0 &
      value <= 1,
    value * 100,
    value
  )
  
  as.integer(round(value))
}

safe_quantile_20b <- function(
    x,
    probability
) {
  x <- x[
    is.finite(x)
  ]
  
  if (length(x) == 0L) {
    return(NA_real_)
  }
  
  as.numeric(
    quantile(
      x,
      probs = probability,
      na.rm = TRUE,
      names = FALSE,
      type = 7
    )
  )
}

display_limits_20b <- function(
    x,
    lower_probability =
      boxplot_lower_quantile_20b,
    upper_probability =
      boxplot_upper_quantile_20b,
    padding_fraction = 0.05
) {
  x <- x[
    is.finite(x)
  ]
  
  if (length(x) == 0L) {
    return(c(-1, 1))
  }
  
  lower_value <- safe_quantile_20b(
    x,
    lower_probability
  )
  
  upper_value <- safe_quantile_20b(
    x,
    upper_probability
  )
  
  if (
    !is.finite(lower_value) ||
    !is.finite(upper_value)
  ) {
    return(range(x, na.rm = TRUE))
  }
  
  if (lower_value == upper_value) {
    spread_value <- max(
      abs(lower_value) * 0.05,
      1
    )
    
    return(
      c(
        lower_value - spread_value,
        upper_value + spread_value
      )
    )
  }
  
  padding_value <-
    (upper_value - lower_value) *
    padding_fraction
  
  c(
    lower_value - padding_value,
    upper_value + padding_value
  )
}

map_limit_20b <- function(
    x,
    probability = map_clip_quantile_20b
) {
  x <- abs(
    x[
      is.finite(x)
    ]
  )
  
  if (length(x) == 0L) {
    return(1)
  }
  
  result <- as.numeric(
    quantile(
      x,
      probs = probability,
      na.rm = TRUE,
      names = FALSE,
      type = 7
    )
  )
  
  if (
    !is.finite(result) ||
    result <= 0
  ) {
    result <- max(x, na.rm = TRUE)
  }
  
  if (
    !is.finite(result) ||
    result <= 0
  ) {
    result <- 1
  }
  
  result
}

latest_file_20b <- function(paths) {
