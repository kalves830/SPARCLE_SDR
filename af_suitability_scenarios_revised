short_box_limits <- function(x, probs = c(0.10, 0.90), pad_fraction = 0.05) {
  x <- x[is.finite(x)]
  lim <- unname(quantile(x, probs = probs, na.rm = TRUE))
  if (!all(is.finite(lim)) || diff(lim) <= 0) lim <- range(x, finite = TRUE)
  if (diff(lim) <= 0) lim <- lim + c(-1, 1)
  pad <- diff(lim) * pad_fraction
  lim + c(-pad, pad)
}

