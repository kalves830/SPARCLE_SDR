# -----------------------------------------------------------------------------
# Canonicalize HydroBASINS ID keys before the degraded/non-degraded join
#
# Use this only after VALIDATION_wsid_overlap_transform_tests.csv confirms
# that `numeric_no_scientific` returns exactly 2,754 shared IDs.
# -----------------------------------------------------------------------------

canonical_hybas_id_20b <- function(x) {
  x <- str_trim(as.character(x))
  
  numeric_x <- suppressWarnings(
    as.numeric(x)
  )
  
  canonical_x <- if_else(
    is.finite(numeric_x),
    format(
      numeric_x,
      scientific = FALSE,
      trim = TRUE
    ),
    x
  )
  
  canonical_x <- str_replace(
    canonical_x,
    "\\.0+$",
    ""
  )
  
  canonical_x
}

degraded_comparison_data_20b <-
  degraded_comparison_data_20b |>
  mutate(
    wsid_join = canonical_hybas_id_20b(wsid)
  )

nondegraded_comparison_data_20b <-
  nondegraded_comparison_data_20b |>
  mutate(
    wsid_join = canonical_hybas_id_20b(wsid)
  )

canonical_id_validation_20b <- bind_rows(
  degraded_comparison_data_20b |>
    distinct(wsid, wsid_join) |>
    count(
      wsid_join,
      name = "n_raw_ids"
    ) |>
    mutate(
      source = "Degraded"
    ),
  
  nondegraded_comparison_data_20b |>
    distinct(wsid, wsid_join) |>
    count(
      wsid_join,
      name = "n_raw_ids"
    ) |>
    mutate(
      source = "Non-degraded"
    )
) |>
  group_by(source) |>
  summarise(
    n_canonical_ids = n(),
    n_ambiguous_canonical_ids = sum(
      n_raw_ids > 1L
    ),
    max_raw_ids_per_canonical_id = max(
      n_raw_ids
    ),
    status = if_else(
      n_ambiguous_canonical_ids == 0L,
      "PASS",
      "FAIL"
    ),
    .groups = "drop"
  )

