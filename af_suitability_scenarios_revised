# -----------------------------------------------------------------------------
# Validate the selected six masks as binary transition masks
#
# A Top-X transition mask must have values limited to 0 and/or 1, with nodata
# permitted. A continuous suitability score is not accepted because the later
# transition code uses `mask > 0`.
# -----------------------------------------------------------------------------

inspect_binary_mask <- function(mask_path) {
  mask_r <- rast(mask_path)
  
  if (nlyr(mask_r) != 1L) {
    return(
      tibble(
        raster_layers = nlyr(mask_r),
        n_unique_values = NA_integer_,
        unique_values_preview = NA_character_,
        binary_mask_pass = FALSE,
        reason = "Raster has more than one layer"
      )
    )
  }
  
  # Align before checking because later sections will use the aligned mask.
  aligned_r <- align_to_lulc_mixed(mask_r)
  
  frequency_r <- freq(
    aligned_r,
    value = TRUE
  ) |>
    as_tibble()
  
  if ("layer" %in% names(frequency_r)) {
    frequency_r <- frequency_r |>
      select(-layer)
  }
  
  unique_values_r <- sort(
    unique(
      frequency_r$value[
        !is.na(frequency_r$value)
      ]
    )
  )
  
  binary_pass_r <-
    length(unique_values_r) >= 1L &&
    length(unique_values_r) <= 2L &&
    all(
      unique_values_r %in%
        c(0, 1)
    )
  
  tibble(
    raster_layers = nlyr(aligned_r),
    n_unique_values = length(unique_values_r),
    unique_values_preview = paste(
      unique_values_r,
      collapse = ";"
    ),
    binary_mask_pass = binary_pass_r,
    reason = if_else(
      binary_pass_r,
      "Binary mask confirmed",
      "Raster is not limited to 0/1 values"
    )
  )
}

