classify_AF_combined_climate <- function(path_x) {
  path_x <- str_to_lower(
    str_replace_all(
      as.character(path_x),
      "\\\\",
      "/"
    )
  )
  
  case_when(
    str_detect(path_x, "ssp.?126") ~ "SSP126",
    str_detect(path_x, "ssp.?370") ~ "SSP370",
    str_detect(path_x, "ssp.?585") ~ "SSP585",
    
    str_detect(
      path_x,
      "baseline|(^|[_/-])base([_/-]|$)"
    ) ~ "Baseline",
    
    TRUE ~ NA_character_
  )
}

