degraded_concentration_20b <-
  degraded_absolute_20b |>
  mutate(
    climate =
      as.character(climate),
    scenario =
      as.character(scenario)
  ) |>
  group_by(
    climate,
    scenario,
    threshold
  ) |>
  arrange(
    desc(
      pmax(
        net_reduction_t_yr,
        0
      )
    ),
    .by_group = TRUE
  ) |>
  mutate(
    positive_reduction_t_yr =
      pmax(
        net_reduction_t_yr,
        0
      ),
    gross_positive_reduction_t_yr =
      sum(
        positive_reduction_t_yr,
        na.rm = TRUE
      ),
    rank_positive =
      row_number(),
    n_group = n(),
    cumulative_positive_reduction_t_yr =
      cumsum(
        positive_reduction_t_yr
      ),
    cumulative_positive_share =
      if_else(
        gross_positive_reduction_t_yr >
          0,
        cumulative_positive_reduction_t_yr /
          gross_positive_reduction_t_yr,
        NA_real_
      )
  ) |>
  ungroup()

degraded_concentration_summary_20b <-
  degraded_concentration_20b |>
  group_by(
    climate,
    scenario,
    threshold
  ) |>
  summarise(
    n_watersheds = n(),
    gross_positive_reduction_t_yr =
      first(
        gross_positive_reduction_t_yr
      ),
    top_1pct_share = sum(
      positive_reduction_t_yr[
        rank_positive <=
          ceiling(
            0.01 *
              first(n_group)
          )
      ],
      na.rm = TRUE
    ) /
      first(
        gross_positive_reduction_t_yr
      ),
    top_5pct_share = sum(
      positive_reduction_t_yr[
        rank_positive <=
          ceiling(
            0.05 *
              first(n_group)
          )
      ],
      na.rm = TRUE
    ) /
      first(
        gross_positive_reduction_t_yr
      ),
    top_10pct_share = sum(
      positive_reduction_t_yr[
        rank_positive <=
          ceiling(
            0.10 *
              first(n_group)
          )
      ],
      na.rm = TRUE
    ) /
      first(
        gross_positive_reduction_t_yr
      ),
    .groups = "drop"
  )

