validate_mixed_biophysical_coverage <- function(
    run_id,
    lulc_path,
    biophysical_table_path
) {
  raster_i <- rast(lulc_path)
  
  raster_codes <- freq(
    raster_i,
    value = TRUE
  ) |>
    as_tibble() |>
    filter(
      !is.na(value)
    ) |>
    pull(value) |>
    as.integer() |>
    unique() |>
    sort()
  
  biophys_i <- read_csv(
    biophysical_table_path,
    show_col_types = FALSE
  ) |>
    mutate(
      lucode = as.integer(lucode),
      usle_c = as.numeric(usle_c),
      usle_p = as.numeric(usle_p)
    )
  
  missing_codes <- setdiff(
    raster_codes,
    biophys_i$lucode
  )
  
  duplicate_codes <- sum(
    duplicated(biophys_i$lucode)
  )
  
  invalid_c_rows <- sum(
    !is.finite(biophys_i$usle_c) |
      biophys_i$usle_c < 0 |
      biophys_i$usle_c > 1
  )
  
  invalid_p_rows <- sum(
    !is.finite(biophys_i$usle_p) |
      biophys_i$usle_p != 1.00
  )
  
  tibble(
    run_id = run_id,
    raster_code_count = length(raster_codes),
    raster_codes = paste(
      raster_codes,
      collapse = ";"
    ),
    biophysical_row_count = nrow(biophys_i),
    duplicate_biophysical_codes = duplicate_codes,
    missing_raster_codes_n = length(missing_codes),
    missing_raster_codes = paste(
      missing_codes,
      collapse = ";"
    ),
    invalid_C_rows = invalid_c_rows,
    non_P1_rows = invalid_p_rows,
    code_coverage_pass =
      length(missing_codes) == 0L &
      duplicate_codes == 0L &
      invalid_c_rows == 0L &
      invalid_p_rows == 0L
  )
}

