discover_degraded_result_20b <- function(
    run_id,
    run_dir,
    manifest_result_path = NA_character_
) {
  candidate_list <- list()
  candidate_index <- 1L
  
  add_candidates_20b <- function(
    paths,
    priority,
    method
  ) {
    if (length(paths) == 0L) {
      return(NULL)
    }
    
    paths <- as.character(paths)
    
    paths <- paths[
      !is.na(paths) &
        nzchar(paths) &
        file.exists(paths)
    ]
    
    if (length(paths) == 0L) {
      return(NULL)
    }
    
    paths <- normalize_path_20b(
      paths,
      must_work = TRUE
    )
    
    paths <- paths[
      !is_nondegraded_path_20b(paths)
    ]
    
    if (length(paths) == 0L) {
      return(NULL)
    }
    
    candidate_list[[candidate_index]] <<-
      tibble(
        result_path = paths,
        priority = as.integer(priority),
        resolution_method = method
      )
    
    candidate_index <<-
      candidate_index + 1L
    
    invisible(NULL)
  }
  
  # ---------------------------------------------------------------------------
  # Priority 1: explicit result path in manifest
  # ---------------------------------------------------------------------------
  
  add_candidates_20b(
    manifest_result_path,
    priority = 1L,
    method =
      "explicit_manifest_result_path"
  )
  
  # ---------------------------------------------------------------------------
  # Priority 2: result directly beneath manifest run_dir
  # ---------------------------------------------------------------------------
  
  run_dir_exact_candidates <- c(
    file.path(
      run_dir,
      "watershed_results_sdr.shp"
    ),
    file.path(
      run_dir,
      "output",
      "watershed_results_sdr.shp"
    ),
    file.path(
      run_dir,
      "outputs",
      "watershed_results_sdr.shp"
    ),
    file.path(
      run_dir,
      "Output",
      "watershed_results_sdr.shp"
    ),
    file.path(
      run_dir,
      "Outputs",
      "watershed_results_sdr.shp"
    )
  )
  
  add_candidates_20b(
    run_dir_exact_candidates,
    priority = 2L,
    method =
      "exact_path_beneath_manifest_run_dir"
  )
  
  # ---------------------------------------------------------------------------
  # Priority 3: exact paths under known degraded roots
  # ---------------------------------------------------------------------------
  
  root_exact_candidates <- unlist(
    map(
      candidate_output_roots_20b,
      function(root_i) {
        c(
          file.path(
            root_i,
            run_id,
            "watershed_results_sdr.shp"
          ),
          file.path(
            root_i,
            run_id,
            "output",
            "watershed_results_sdr.shp"
          ),
          file.path(
            root_i,
            run_id,
            "outputs",
            "watershed_results_sdr.shp"
          ),
          file.path(
            root_i,
            run_id,
            "Output",
            "watershed_results_sdr.shp"
          ),
          file.path(
            root_i,
            run_id,
            "Outputs",
            "watershed_results_sdr.shp"
          )
        )
      }
    )
  )
  
  add_candidates_20b(
    root_exact_candidates,
    priority = 3L,
    method =
      "exact_run_id_path_beneath_degraded_root"
  )
  
  # ---------------------------------------------------------------------------
  # Priority 4: recursive exact directory-component match
  # ---------------------------------------------------------------------------
  
  if (
    length(
      all_degraded_result_shapefiles_20b
    ) > 0L
  ) {
    recursive_match <- contains_exact_run_component_20b(
      all_degraded_result_shapefiles_20b,
      run_id
    )
    
    recursive_candidates <-
      all_degraded_result_shapefiles_20b[
        recursive_match
      ]
    
    add_candidates_20b(
      recursive_candidates,
      priority = 4L,
      method =
        "recursive_exact_run_directory_match"
    )
  }
  
  # ---------------------------------------------------------------------------
  # Resolve using the highest available priority
  # ---------------------------------------------------------------------------
  
  if (length(candidate_list) == 0L) {
    return(
      tibble(
        run_id = run_id,
        candidate_count = 0L,
        best_priority = NA_integer_,
        result_path = NA_character_,
        resolution_method =
          "not_found",
        all_candidates =
          NA_character_,
        status = "FAIL"
      )
    )
  }
  
  candidates <- bind_rows(
    candidate_list
  ) |>
    arrange(
      priority,
      result_path
    ) |>
    distinct(
      result_path,
      .keep_all = TRUE
    )
  
  best_priority_value <-
    min(candidates$priority)
  
  best_candidates <-
    candidates |>
    filter(
      priority ==
        best_priority_value
    )
  
  all_candidates_text <-
    candidates |>
    mutate(
      candidate_label = paste0(
        "priority=",
        priority,
        "; method=",
        resolution_method,
        "; path=",
        result_path
      )
    ) |>
    pull(candidate_label) |>
    paste(collapse = " | ")
  
  if (nrow(best_candidates) == 1L) {
    return(
      tibble(
        run_id = run_id,
        candidate_count =
          nrow(candidates),
        best_priority =
          best_priority_value,
        result_path =
          best_candidates$result_path[1],
        resolution_method =
          best_candidates$
          resolution_method[1],
        all_candidates =
          all_candidates_text,
        status = "PASS"
      )
    )
  }
  
  tibble(
    run_id = run_id,
    candidate_count =
      nrow(candidates),
    best_priority =
      best_priority_value,
    result_path =
      NA_character_,
    resolution_method =
      "ambiguous_at_best_priority",
    all_candidates =
      all_candidates_text,
    status = "FAIL"
  )
}

