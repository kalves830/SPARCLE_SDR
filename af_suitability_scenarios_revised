normalize_path_20b <- function(
    x,
    must_work = FALSE
) {
  if (length(x) == 0L) {
    return(character())
  }
  
  x <- as.character(x)
  
  x <- x[
    !is.na(x) &
      nzchar(x)
  ]
  
  if (length(x) == 0L) {
    return(character())
  }
  
  normalizePath(
    x,
    winslash = "/",
    mustWork = must_work
  )
}

is_nondegraded_path_20b <- function(x) {
  x <- str_to_lower(
    str_replace_all(
      as.character(x),
      "\\\\",
      "/"
    )
  )
  
  str_detect(
    x,
    "(^|/)non[-_ ]?degraded(/|$)"
  )
}

is_degraded_path_20b <- function(x) {
  x <- str_to_lower(
    str_replace_all(
      as.character(x),
      "\\\\",
      "/"
    )
  )
  
  str_detect(
    x,
    "(^|/)(degraded|degradation)(/|_|-|$)"
  ) &
    !is_nondegraded_path_20b(x)
}

contains_exact_run_component_20b <- function(
    paths,
    run_id
) {
  run_id_lower <- str_to_lower(
    as.character(run_id)
  )
  
  vapply(
    paths,
    function(path_i) {
      path_parts <- str_split(
        str_to_lower(
          str_replace_all(
            as.character(path_i),
            "\\\\",
            "/"
          )
        ),
        "/",
        simplify = FALSE
      )[[1]]
      
      any(path_parts == run_id_lower)
    },
    logical(1)
  )
}

