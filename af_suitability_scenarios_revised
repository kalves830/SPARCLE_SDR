# -----------------------------------------------------------------------------
# 20B.4 Read and standardize InVEST watershed results
# HydroBASINS watershed key: hybas_id
# Sediment-export field: sed_export
# -----------------------------------------------------------------------------

read_sdr_result_20b <- function(
    result_path,
    run_id,
    run_type,
    climate,
    scenario,
    threshold,
    reference_run_id
) {
  result_sf <- st_read(
    result_path,
    quiet = TRUE
  ) |>
    clean_names_20b()
  
  result_table <- st_drop_geometry(
    result_sf
  )
  
  id_column <- pick_column_20b(
    names(result_table),
    c(
      "hybas_id",
      "hybasid",
      "hybas",
      "ws_id",
      "watershed_id",
      "watershed",
      "wsid",
      "subws_id",
      "subwatershed_id",
      "fid",
      "id"
    ),
    required = TRUE,
    label = "watershed identifier"
  )
  
  sediment_column <- pick_column_20b(
    names(result_table),
    c(
      "sed_export",
      "sed_expor",
      "sedexport",
      "sed_exp",
      "sediment_export"
    ),
    required = TRUE,
    label = "sediment-export field"
  )
  
  standardized_table <- tibble(
    wsid = as.character(
      result_table[[id_column]]
    ),
    sed_export_t_yr = as.numeric(
      result_table[[sediment_column]]
    )
  ) |>
    mutate(
      run_id = as.character(run_id),
      run_type = as.character(run_type),
      climate = as.character(climate),
      scenario = as.character(scenario),
      threshold = as.integer(threshold),
      reference_run_id = as.character(reference_run_id),
      result_path = as.character(result_path),
      source_id_column = id_column,
      source_sediment_column = sediment_column
    ) |>
    select(
      run_id,
      run_type,
      climate,
      scenario,
      threshold,
      reference_run_id,
      wsid,
      sed_export_t_yr,
      result_path,
      source_id_column,
      source_sediment_column
    )
  
  blank_wsid_n <- sum(
    is.na(standardized_table$wsid) |
      !nzchar(standardized_table$wsid)
  )
  
  duplicate_wsid_n <- sum(
    duplicated(standardized_table$wsid)
  )
  
  nonfinite_sediment_n <- sum(
    !is.finite(
      standardized_table$sed_export_t_yr
    )
  )
  
  if (blank_wsid_n > 0L) {
    stop(
      "Missing or blank hybas_id values in run ",
      run_id,
      ": ",
      blank_wsid_n,
      "."
    )
  }
  
  if (duplicate_wsid_n > 0L) {
    duplicate_ids <- standardized_table |>
      count(wsid, name = "n") |>
      filter(n > 1L)
    
    write_csv(
      duplicate_ids,
      file.path(
        deg_abs_out,
        paste0(
          "VALIDATION_duplicate_hybas_id_",
          run_id,
          ".csv"
        )
      )
    )
    
    stop(
      "Duplicate hybas_id values in run ",
      run_id,
      "."
    )
  }
  
  if (nonfinite_sediment_n > 0L) {
    bad_rows <- standardized_table |>
      filter(
        !is.finite(sed_export_t_yr)
      )
    
    write_csv(
      bad_rows,
      file.path(
        deg_abs_out,
        paste0(
          "VALIDATION_nonfinite_sed_export_",
          run_id,
          ".csv"
        )
      )
    )
    
    stop(
      "Non-finite sed_export values in run ",
      run_id,
      "."
    )
  }
  
  standardized_table
}

