  )

paired_condition_comparison_20b <-
  inner_join(
    paired_degraded_20b,
    paired_nondegraded_20b,
    by = c(
      "climate",
      "scenario",
      "threshold",
      "wsid_join"
    )
  ) |>
  mutate(
    difference_degraded_minus_nondegraded_t_yr =
      degraded_net_reduction_t_yr -
      nondegraded_net_reduction_t_yr,
    
    difference_absolute_change_degraded_minus_nondegraded_t_yr =
      degraded_absolute_change_t_yr -
      nondegraded_absolute_change_t_yr,
    
    ratio_degraded_to_nondegraded = if_else(
      abs(
        nondegraded_net_reduction_t_yr
      ) > zero_tolerance_20b,
      degraded_net_reduction_t_yr /
        nondegraded_net_reduction_t_yr,
      NA_real_
    ),
    
    difference_interpretation = case_when(
      difference_degraded_minus_nondegraded_t_yr >
        zero_tolerance_20b ~
        "Greater reduction on degraded land",
      
      difference_degraded_minus_nondegraded_t_yr <
        -zero_tolerance_20b ~
        "Greater reduction on non-degraded land",
      
      TRUE ~
        "Near equal reduction"
    )
  )

